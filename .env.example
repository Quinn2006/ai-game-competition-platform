# Copy to .env and configure locally; never commit real credentials.
APP_ENV=development
HOST=127.0.0.1
PORT=4320
MAIN_ORIGIN=http://127.0.0.1:4320
GAME_ORIGIN=http://127.0.0.2:4321
LOCAL_GAMES=1
DATABASE_TLS=disable
SUBMISSIONS_ROOT=data/submissions
EXPORTS_ROOT=data/exports
CLAMD_PORT=3310
# DATABASE_URL and SESSION_SECRET are generated by npm run local:init.

# Production local private storage (illustrative only; values are supplied by the operator,
# never committed). Both public origins must be HTTPS and different registrable domains.
# APP_ENV=production
# HOST=127.0.0.1
# MAIN_ORIGIN=<operator-supplied HTTPS origin>
# GAME_ORIGIN=<operator-supplied second HTTPS origin>
# DATABASE_URL=<operator-supplied production database URL>
# DATABASE_TLS=verify-full
# SESSION_SECRET=<operator-supplied secret of at least 32 bytes>
# PRIVATE_STORAGE_DRIVER=local
# PRIVATE_STORAGE_ROOT=data/submissions
# PRIVATE_STORAGE_ACCOUNT=<dedicated Windows service account, e.g. HOST\\svc-agp-main>
# PRIVATE_STORAGE_ACCOUNT_SID=<its SID, e.g. S-1-5-21-...; preferred to avoid localised names>
# PRIVATE_STORAGE_EXTRA_SIDS=<optional comma-separated trusted SIDs, e.g. a read-only backup account>
# OBJECT_STORAGE_ENDPOINT / OBJECT_STORAGE_BUCKET must NOT be set in local driver mode.
# The private root must not be frontend/, backend/, data/postgres/ or data/backups/.
# The root and every parent directory must have inheritance disabled and only the
# service account, SYSTEM and Administrators in the ACL. Authenticated Users,
# Users, Everyone and any unresolvable principal cause a fail-closed startup refusal.
# The service process must run as PRIVATE_STORAGE_ACCOUNT; a mismatch also fails closed.
